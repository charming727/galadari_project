# Galadari voice agent -- required environment variables.
# Copy to .env and fill in. Never commit the filled-in .env.

# --- LiveKit (project: that-corner) -------------------------------------
# Server URL for the LiveKit Cloud project the agent joins.
LIVEKIT_URL=
# Credentials from the LiveKit Cloud dashboard -> Settings -> Keys.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- OpenAI -------------------------------------------------------------
# Used for BOTH the Realtime speech-to-speech model and the menu
# embeddings that back the Chroma index.
OPENAI_API_KEY=

# --- Dispatch -----------------------------------------------------------
# Which waiter to summon. Empty/unset = AUTOMATIC dispatch: the worker joins
# any room created on the project, which is what local dev uses.
# Set to the same non-empty value on BOTH the agent and the Vercel frontend
# (e.g. galadari-waiter) to use EXPLICIT dispatch, so a hosted worker only
# takes rooms meant for it. Read by agent.py and web/app/api/
# connection-details/route.ts.
AGENT_NAME=

# --- Optional -----------------------------------------------------------
# Idle worker processes kept warm. Unset = LiveKit's default of one per CPU
# core (128 on the demo VM). Set to a small number when hosting. See README.
NUM_IDLE_PROCESSES=

# --- Present in the current .env but NO LONGER USED ---------------------
# The agent is pure speech-to-speech via the OpenAI Realtime model; the
# Deepgram STT plugin is neither installed nor imported (see agent.py).
# Listed for completeness only -- you do not need to set it.
# DEEPGRAM_API_KEY=
