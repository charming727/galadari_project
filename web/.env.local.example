# Copy to .env.local and fill in (same values as the agent's ../.env).
# These stay server-side; the browser only ever receives a short-lived room token.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Must match the agent's AGENT_NAME. Leave unset for local dev (automatic
# dispatch); set to e.g. galadari-waiter in Vercel to dispatch explicitly
# to the hosted worker.
AGENT_NAME=
